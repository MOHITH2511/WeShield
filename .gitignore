# --------------------
# WeShield .gitignore
# Keep this file minimal and specific: don't duplicate entries.
# --------------------

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
venv/
backend/venv/
frontend/venv/
.venv/
env/
ENV/

# Environment & secrets
.env
.env.*

# Logs and runtime
*.log
stream_logs/
sos_logs/
sos_snaps/
uploads/
backend/uploads/
frontend/uploads/

# Models and large binaries (ignored by default; use Git LFS if you want to track them)
*.pth
*.pt
*.onnx
*.ckpt
*.h5
*.pb
*.tflite
models/
weights/
backend/models/

# Node / JS
node_modules/
/frontend/node_modules/
/backend/node_modules/
pnpm-debug.log*

# Lockfiles
# Keep lockfiles for reproducible installs. Remove the lines below if you prefer to ignore them.
# pnpm-lock.yaml
# package-lock.json
# yarn.lock

# Frontend build artifacts
frontend/.next/
.next/
dist/
build/
out/

# Caches, test artifacts
.pytest_cache/
.mypy_cache/
.cache/
pip-wheel-metadata/
__pypackages__/

# IDEs and OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Binaries and archives
*.dll
*.so
*.dylib
*.lib
*.a
*.exe
*.bin
*.zip
*.tar
*.tar.gz
*.tgz

# Notes
# Use Git LFS for very large files (models, datasets). To enable LFS, run:
#   git lfs install
#   git lfs track "*.pth" "*.pt"
# and commit the generated .gitattributes file.
